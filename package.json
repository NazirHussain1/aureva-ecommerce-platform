{
  "name": "aureva",
  "version": "1.0.0",
  "description": "Aureva Beauty E-Commerce Platform - Serverless on Vercel",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../api && npm install",
    "build": "cd frontend && npm install && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && npm start",
    "vercel:dev": "vercel dev",
    "vercel:deploy": "vercel",
    "vercel:prod": "vercel --prod",
    "clean": "rm -rf node_modules backend/node_modules frontend/node_modules api/node_modules"
  },
  "keywords": [
    "ecommerce",
    "beauty",
    "cosmetics",
    "react",
    "nodejs",
    "mongodb",
    "vercel",
    "serverless"
  ],
  "author": "Aureva Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
