# ================================
# API CONFIGURATION
# ================================
# Backend API URL (change for production)
# IMPORTANT: Use HTTPS in production, never HTTP
# Example production: VITE_API_URL=https://api.aureva.com
VITE_API_URL=http://localhost:5000

# ================================
# SECURITY NOTES
# ================================
# 1. Never commit .env files with real credentials to version control
# 2. Use different API URLs for development, staging, and production
# 3. Ensure backend API uses HTTPS in production
# 4. Keep this file updated when adding new environment variables
# 5. Rotate API keys and secrets regularly
# 6. Use strong, unique values for production environments

# ================================
# OPTIONAL: ANALYTICS & TRACKING
# ================================
# VITE_GOOGLE_ANALYTICS_ID=your_ga_id
# VITE_FACEBOOK_PIXEL_ID=your_fb_pixel_id
